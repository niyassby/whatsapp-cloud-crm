# Copy to .env (root) -- apps load their own env; this file documents all variables.
NODE_ENV=development
LOG_LEVEL=info

# Ports
API_PORT=4000
WORKER_HEALTH_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database (pooled for runtime, direct for migrations)
DATABASE_URL=postgresql://wacrm:wacrm@localhost:5432/wacrm
DIRECT_URL=postgresql://wacrm:wacrm@localhost:5432/wacrm

REDIS_URL=redis://localhost:6379

# Auth (min 32 chars each)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-2

# AES-256-GCM key, base64 of 32 random bytes: openssl rand -base64 32
ENCRYPTION_KEY=

# Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=wacrm-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Platform billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENTRY_DSN=
