# Copy to .env (root) -- apps load their own env; this file documents all variables.
NODE_ENV=development
LOG_LEVEL=info

# Ports
API_PORT=4000
WORKER_HEALTH_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# This API as outside services reach it (integration webhooks, OAuth callbacks). A tunnel in development.
API_PUBLIC_URL=http://localhost:4000
# Adds the Demo Store connector, for trying integrations locally (API and worker).
INTEGRATIONS_DEMO=false
# Shopify app (Partner dashboard > Apps > your app > Client credentials). API and worker.
# The secret also signs every Shopify webhook. Redirect URL: <API_PUBLIC_URL>/integrations/oauth/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Google app for the Google Sheets connector (Google Cloud > APIs & Services > Credentials, OAuth
# client, Sheets API enabled). Redirect URI: <API_PUBLIC_URL>/integrations/oauth/callback. API and worker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HubSpot public app (developers.hubspot.com > Apps), same redirect URL. API and worker.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# AI (API and worker). Leave AI_PROVIDER empty to turn AI features off for the installation.
# anthropic: Claude through the official SDK (model AI_MODEL, default claude-opus-5-5).
# fake: deterministic answers with no network, for local runs and tests (refused in production).
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=
# Knowledge base embeddings: voyage, openai (any OpenAI-compatible endpoint) or fake.
# Vectors are 1024 numbers; changing the provider or model means reindexing documents.
AI_EMBEDDINGS_PROVIDER=
AI_EMBEDDINGS_MODEL=
VOYAGE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local service URLs use 127.0.0.1, not localhost: on Windows localhost resolves to IPv6 (::1)
# first and each new connection stalls for seconds before falling back to Docker on IPv4.
# Browser-facing URLs (NEXT_PUBLIC_API_URL, WEB_URL) stay on localhost so cookies stay same-site.

# Database
# DATABASE_URL: runtime (pooled in prod). MUST be a non-owner role that is a member of
#   app_user, so Row Level Security applies. Locally created by `pnpm db:roles`.
# DIRECT_URL: schema owner, direct (non-pooled) connection. Migrations, seed, studio only.
DATABASE_URL=postgresql://wacrm_app:wacrm_app@127.0.0.1:5433/wacrm
DIRECT_URL=postgresql://wacrm:wacrm@127.0.0.1:5433/wacrm
# Integration tests use a separate database (created automatically). Defaults shown.
TEST_DATABASE_URL=postgresql://wacrm_app:wacrm_app@127.0.0.1:5433/wacrm_test
TEST_DIRECT_URL=postgresql://wacrm:wacrm@127.0.0.1:5433/wacrm_test

REDIS_URL=redis://127.0.0.1:6379

# Auth. DEV-ONLY values below: the API refuses to start in production while they contain
# "dev-only". Generate real ones with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-0123456789abcdef0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-0123456789abcdef012345678
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE defaults to true when NODE_ENV=production
# COOKIE_SECURE=false
# Set behind a load balancer so rate limits see the client IP
TRUST_PROXY=false

# AES-256-GCM key encryption key, base64 of 32 bytes: openssl rand -base64 32
# DEV-ONLY key below (all bytes "dev-only-encryption-key-32bytes!"). Never use it in production.
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
# Comma-separated old keys still accepted for decryption while rotating
ENCRYPTION_KEY_PREVIOUS=

# Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Facebook Login for Business configuration used by Embedded Signup
META_EMBEDDED_SIGNUP_CONFIG_ID=
# System-user-token connect form. Defaults to on outside production.
# ALLOW_MANUAL_CONNECT=true

QUEUE_PREFIX=wacrm

# Wallet. Rate cards must exist in this currency: pnpm rates:import <file.csv>
WALLET_DEFAULT_CURRENCY=INR
WALLET_LOW_BALANCE_DEFAULT=100

# Campaigns
CAMPAIGN_MPS_PER_NUMBER=40
CAMPAIGN_MAX_FAILURE_RATE=0.2
WEBHOOK_RETENTION_DAYS=30
WORKER_CONCURRENCY=10
# Cloud API default; Meta raises this for some numbers.
OUTBOUND_MPS_PER_NUMBER=80

# S3-compatible storage (SeaweedFS locally; R2 / S3 in prod)
S3_ENDPOINT=http://127.0.0.1:9000
# Signed media links open in the browser. Stays on localhost so it is reachable from there.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=wacrm-media
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdev-secret

# Platform billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public API
API_RATE_LIMIT_PER_MINUTE=600
# Printed on invoices.
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_TAX_ID=

# Email. Local: Mailpit (inbox at http://localhost:8025). Prod: any SMTP provider.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="WhatsApp CRM <no-reply@localhost>"
APP_NAME="WhatsApp CRM"

SENTRY_DSN=
