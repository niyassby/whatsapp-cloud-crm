# Copy to .env (root) -- apps load their own env; this file documents all variables.
NODE_ENV=development
LOG_LEVEL=info

# Ports
API_PORT=4000
WORKER_HEALTH_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database
# DATABASE_URL: runtime (pooled in prod). MUST be a non-owner role that is a member of
#   app_user, so Row Level Security applies. Locally created by `pnpm db:roles`.
# DIRECT_URL: schema owner, direct (non-pooled) connection. Migrations, seed, studio only.
DATABASE_URL=postgresql://wacrm_app:wacrm_app@localhost:5433/wacrm
DIRECT_URL=postgresql://wacrm:wacrm@localhost:5433/wacrm
# Integration tests use a separate database (created automatically). Defaults shown.
TEST_DATABASE_URL=postgresql://wacrm_app:wacrm_app@localhost:5433/wacrm_test
TEST_DIRECT_URL=postgresql://wacrm:wacrm@localhost:5433/wacrm_test

REDIS_URL=redis://localhost:6379

# Auth (min 32 chars each)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-2

# AES-256-GCM key, base64 of 32 random bytes: openssl rand -base64 32
ENCRYPTION_KEY=

# Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# S3-compatible storage (SeaweedFS locally; R2 / S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=wacrm-media
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdev-secret

# Platform billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENTRY_DSN=
