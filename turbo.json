{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"],
      "inputs": ["prisma/schema.prisma"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "DATABASE_URL",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "TEST_DIRECT_URL",
    "DATABASE_POOL_MAX",
    "REDIS_URL",
    "QUEUE_PREFIX",
    "WEBHOOK_RETENTION_DAYS",
    "WORKER_CONCURRENCY",
    "OUTBOUND_MPS_PER_NUMBER"
  ]
}
