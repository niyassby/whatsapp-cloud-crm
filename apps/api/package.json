    "@nestjs/swagger": "^12.1.1",
    "@nestjs/websockets": "12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@wacrm/billing": "workspace:^",
