// Prisma schema. Tenancy rules (see CLAUDE.md):
// - Every tenant table has org_id and is covered by Row Level Security
//   (policies live in hand-written SQL migrations, e.g. 0002_rls).
// - App code connects as a non-owner role (member of app_user) so RLS always applies.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PartnerStatus {
  active
  suspended
}

enum OrgStatus {
  active
  suspended
}

enum UserStatus {
  active
  disabled
}

enum Role {
  owner
  admin
  agent
}

enum MembershipStatus {
  active
  invited
  disabled
}

enum WabaStatus {
  active
  disconnected
}

enum PhoneNumberStatus {
  pending
  connected
  registration_failed
  disconnected
}

enum CredentialSource {
  embedded_signup
  manual
}

enum WebhookEventStatus {
  received
  routed
  processed
  ignored
  failed
}

enum DataDeletionStatus {
  received
  completed
}

enum ConversationStatus {
  open
  closed
}

enum MessageDirection {
  inbound
  outbound
  internal
}

enum MessageStatus {
  received
  queued
  sending
  sent
  delivered
  read
  failed
}

enum MediaStatus {
  pending
  stored
  failed
}

enum ContactOptInStatus {
  unknown
  opted_in
  opted_out
}

enum ContactFieldType {
  text
  number
  date
  boolean
  select
}

enum ContactJobKind {
  import
  export
}

enum ContactJobStatus {
  queued
  processing
  completed
  failed
}

enum WalletEntryType {
  credit
  debit
  refund
  adjustment
}

enum WalletReservationStatus {
  active
  released
  expired
}

enum CampaignStatus {
  draft
  scheduled
  preparing
  running
  paused
  completed
  cancelled
  failed
}

enum CampaignRecipientStatus {
  pending
  sending
  sent
  delivered
  read
  replied
  failed
  skipped
  cancelled
}

enum DripSequenceStatus {
  draft
  active
  paused
}

enum DripEnrollmentStatus {
  active
  completed
  exited
}

enum AuthTokenType {
  email_verification
  password_reset
}

/// Resellers. Kept simple until Section 4. TODO(branding): reseller theming plugs in here later.
model Partner {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String        @unique
  status    PartnerStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]

  @@map("partners")
}

/// Tenant root. organizations.id is the value of app.org_id.
model Organization {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  slug           String    @unique
  partnerId      String?   @map("partner_id") @db.Uuid
  status         OrgStatus @default(active)
  timezone       String    @default("UTC")
  /// Whole-message opt-out keywords. Empty uses DEFAULT_OPT_OUT_KEYWORDS from @wacrm/shared.
  optOutKeywords String[]  @default([]) @map("opt_out_keywords")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  partner        Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  memberships    Membership[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  invitations    Invitation[]
  refreshTokens  RefreshToken[]
  wabaAccounts   WabaAccount[]
  phoneNumbers   PhoneNumber[]
  webhookEvents  WebhookEvent[]
  contacts       Contact[]
  conversations  Conversation[]
  messages       Message[]
  labels         Label[]
  cannedReplies  CannedReply[]
  tags           Tag[]
  contactFields  ContactField[]
  segments       Segment[]
  contactJobs    ContactJob[]
  templates      MessageTemplate[]
  wallet         Wallet?
  campaigns      Campaign[]
  dripSequences  DripSequence[]
  walletEntries  WalletLedger[]
  walletHolds    WalletReservation[]
  /**
   * Printed on invoices. Country decides the tax rate.
   */
  billingName    String?             @map("billing_name")
  billingEmail   String?             @map("billing_email")
  billingAddress String?             @map("billing_address")
  billingCountry String?             @map("billing_country")
  taxId          String?             @map("tax_id")

  subscription           Subscription?
  walletTopups           WalletTopup[]
  invoices               Invoice[]
  billingEvents          BillingEvent[]
  webhookEndpoints       WebhookEndpoint[]
  webhookDeliveries      WebhookDelivery[]
  automationSettings     AutomationSettings?
  autoReplyRules         AutoReplyRule[]
  assignmentRules        AssignmentRule[]
  notifications          Notification[]
  flows                  Flow[]
  flowVersions           FlowVersion[]
  flowRuns               FlowRun[]
  flowRunSteps           FlowRunStep[]
  integrationConnections IntegrationConnection[]
  integrationEvents      IntegrationEvent[]
  integrationEventClaims IntegrationEventClaim[]
  aiSettings             AiSettings?
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeChunks        KnowledgeChunk[]
  aiLogs                 AiLog[]

  @@index([partnerId])
  @@map("organizations")
}

/// Global identity. A user can belong to many organizations through memberships.
/// Email is stored lower-cased (enforced by a CHECK constraint).
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  name              String
  status            UserStatus @default(active)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// TOTP secret, AES-256-GCM envelope encrypted (SecretBox). Set at setup, active once enabled.
  totpSecretEnc     String?    @map("totp_secret_enc")
  totpEnabledAt     DateTime?  @map("totp_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; codes at or before it are rejected (replay protection).
  totpLastStep      Int?       @map("totp_last_step")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships           Membership[]
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  authTokens            AuthToken[]
  invitationsSent       Invitation[]          @relation("InvitedBy")
  invitationsAccepted   Invitation[]          @relation("AcceptedBy")
  wabaAccountsConnected WabaAccount[]
  conversationsAssigned Conversation[]
  messagesSent          Message[]
  cannedRepliesCreated  CannedReply[]
  contactNotes          ContactNote[]
  consentEvents         ContactConsentEvent[]
  segmentsCreated       Segment[]
  contactJobs           ContactJob[]
  templatesCreated      MessageTemplate[]
  walletEntries         WalletLedger[]
  campaignsCreated      Campaign[]
  dripSequencesCreated  DripSequence[]
  walletTopups          WalletTopup[]
  webhookEndpoints      WebhookEndpoint[]
  notifications         Notification[]

  @@map("users")
}

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set by the agent. Unavailable agents are not given new conversations.
  available    Boolean      @default(true)
  /// Lower-case labels such as "hindi" or "billing", used by skill-based assignment.
  skills       String[]     @default([])

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Public API keys. Only a SHA-256 hash of the secret is stored; prefix identifies the key.
model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String    @unique @map("key_hash")
  scopes      String[]  @default([])
  createdById String?   @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  hooks        WebhookEndpoint[]

  @@index([orgId])
  @@map("api_keys")
}

/// Append-only. The app role has SELECT + INSERT only (no UPDATE / DELETE).
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorApiKeyId String?  @map("actor_api_key_id") @db.Uuid
  action        String
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  metadata      Json?
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Rotating refresh tokens. A login starts a family; each refresh replaces the token.
/// Presenting a replaced/revoked token revokes the whole family (reuse detection).
model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  /// HMAC-SHA256 of the token (pepper = JWT_REFRESH_SECRET). The raw token is never stored.
  tokenHash     String    @unique @map("token_hash")
  /// Organization selected in this session (null when the user has none).
  orgId         String?   @map("org_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// Single-use emailed tokens (verification, password reset). Only the hash is stored.
model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Invitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  email        String
  role         Role
  tokenHash    String    @unique @map("token_hash")
  invitedById  String?   @map("invited_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, email])
  @@map("invitations")
}

/// A WhatsApp Business Account connected to an org. A WABA is active in at most one org
/// (partial unique index in the migration); a disconnected row may be reconnected elsewhere.
model WabaAccount {
  id                  String     @id @default(uuid(7)) @db.Uuid
  orgId               String     @map("org_id") @db.Uuid
  wabaId              String     @map("waba_id")
  name                String?
  currency            String?
  timezoneId          String?    @map("timezone_id")
  templateNamespace   String?    @map("template_namespace")
  status              WabaStatus @default(active)
  /// App-scoped Facebook user who connected it. Matched against deletion and deauth callbacks.
  metaUserId          String?    @map("meta_user_id")
  connectedById       String?    @map("connected_by_id") @db.Uuid
  webhookSubscribedAt DateTime?  @map("webhook_subscribed_at") @db.Timestamptz(3)
  /// Null until the first comparison with Meta.
  templatesSyncedAt   DateTime?  @map("templates_synced_at") @db.Timestamptz(3)
  disconnectedAt      DateTime?  @map("disconnected_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectedBy  User?             @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  phoneNumbers PhoneNumber[]
  templates    MessageTemplate[]

  @@unique([orgId, wabaId])
  @@index([metaUserId])
  @@map("waba_accounts")
}

/// A business phone number. access_token_enc and registration_pin_enc are SecretBox ciphertext
/// bound to this row by AAD, and must never leave the API.
model PhoneNumber {
  id                     String            @id @default(uuid(7)) @db.Uuid
  orgId                  String            @map("org_id") @db.Uuid
  wabaAccountId          String            @map("waba_account_id") @db.Uuid
  phoneNumberId          String            @map("phone_number_id")
  displayPhoneNumber     String?           @map("display_phone_number")
  verifiedName           String?           @map("verified_name")
  qualityRating          String?           @map("quality_rating")
  /// e.g. TIER_250. A string on purpose: Meta changes tiers, limits live in config.
  messagingTier          String?           @map("messaging_tier")
  codeVerificationStatus String?           @map("code_verification_status")
  nameStatus             String?           @map("name_status")
  platformType           String?           @map("platform_type")
  status                 PhoneNumberStatus @default(pending)
  statusReason           String?           @map("status_reason")
  credentialSource       CredentialSource  @map("credential_source")
  accessTokenEnc         String?           @map("access_token_enc")
  registrationPinEnc     String?           @map("registration_pin_enc")
  registeredAt           DateTime?         @map("registered_at") @db.Timestamptz(3)
  lastSyncedAt           DateTime?         @map("last_synced_at") @db.Timestamptz(3)
  disconnectedAt         DateTime?         @map("disconnected_at") @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wabaAccount        WabaAccount         @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  campaigns          Campaign[]
  dripSequences      DripSequence[]
  campaignRecipients CampaignRecipient[]

  @@unique([orgId, phoneNumberId])
  @@index([wabaAccountId])
  @@map("phone_numbers")
}

/// Raw inbound webhook changes, kept for replay. org_id is null until a worker routes the event.
/// Inserted and routed only through SECURITY DEFINER functions.
model WebhookEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  orgId         String?            @map("org_id") @db.Uuid
  provider      String             @default("meta")
  /// sha256 of the payload: Meta redeliveries collapse onto one row.
  dedupeKey     String             @unique @map("dedupe_key")
  wabaId        String?            @map("waba_id")
  phoneNumberId String?            @map("phone_number_id")
  field         String?
  payload       Json
  status        WebhookEventStatus @default(received)
  attempts      Int                @default(0)
  error         String?
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt   DateTime?          @map("processed_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, receivedAt(sort: Desc), id(sort: Desc)])
  @@index([receivedAt])
  @@map("webhook_events")
}

/// Meta data deletion callbacks. Not tenant data: keyed by Facebook user, public by code only.
model DataDeletionRequest {
  id               String             @id @default(uuid(7)) @db.Uuid
  metaUserId       String             @map("meta_user_id")
  confirmationCode String             @unique @map("confirmation_code")
  status           DataDeletionStatus @default(received)
  requestedAt      DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(3)

  @@map("data_deletion_requests")
}

/// A customer on WhatsApp. wa_id is the phone number, or a business-scoped id for username users.
/// Deleted and merged contacts keep their row: the number stays reserved, so a later message or
/// import finds the existing consent record (an opt-out must survive a re-import).
model Contact {
  id             String             @id @default(uuid(7)) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  /// E.164 digits without the plus.
  waId           String             @map("wa_id")
  name           String?
  email          String?
  /// Values validated against contact_fields by the service.
  customFields   Json               @default("{}") @map("custom_fields")
  optInStatus    ContactOptInStatus @default(unknown) @map("opt_in_status")
  optInSource    String?            @map("opt_in_source")
  optInProof     String?            @map("opt_in_proof")
  optInAt        DateTime?          @map("opt_in_at") @db.Timestamptz(3)
  optOutAt       DateTime?          @map("opt_out_at") @db.Timestamptz(3)
  /// Last message from this contact.
  lastActivityAt DateTime?          @map("last_activity_at") @db.Timestamptz(3)
  /// Set on the duplicate. Messages from its number go to the primary contact.
  mergedIntoId   String?            @map("merged_into_id") @db.Uuid
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]
  dripEnrollments    DripEnrollment[]
  flowRuns           FlowRun[]
  mergedInto         Contact?              @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  duplicates         Contact[]             @relation("ContactMerge")
  tags               ContactTag[]
  notes              ContactNote[]
  consentEvents      ContactConsentEvent[]

  @@unique([orgId, waId])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, optInStatus])
  @@index([orgId, lastActivityAt])
  @@map("contacts")
}

/// Contact tags. Separate from labels, which classify conversations.
model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]

  @@unique([orgId, name])
  @@map("tags")
}

model ContactTag {
  orgId     String @map("org_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@index([orgId])
  @@map("contact_tags")
}

/// Definitions of a workspace's custom fields. Values live in contacts.custom_fields.
model ContactField {
  id        String           @id @default(uuid(7)) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  key       String
  label     String
  type      ContactFieldType
  options   String[]         @default([])
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("contact_fields")
}

model ContactNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt(sort: Desc)])
  @@index([orgId])
  @@map("contact_notes")
}

/// Append-only proof of every consent change (no UPDATE or DELETE grant).
model ContactConsentEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  contactId   String             @map("contact_id") @db.Uuid
  status      ContactOptInStatus
  /// manual, import, keyword, merge, ...
  source      String?
  proof       String?
  actorUserId String?            @map("actor_user_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt(sort: Desc)])
  @@index([orgId])
  @@map("contact_consent_events")
}

/// A saved filter. Counts are computed when asked, so they are never stale.
model Segment {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  filter      Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@map("segments")
}

/// Background contact imports and exports.
model ContactJob {
  id            String           @id @default(uuid(7)) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  kind          ContactJobKind
  status        ContactJobStatus @default(queued)
  createdById   String?          @map("created_by_id") @db.Uuid
  filename      String?
  /// Import: column mapping and consent statement. Export: the filter.
  options       Json
  processedRows Int              @default(0) @map("processed_rows")
  createdCount  Int              @default(0) @map("created_count")
  updatedCount  Int              @default(0) @map("updated_count")
  errorCount    Int              @default(0) @map("error_count")
  /// Import: the per-row error report. Export: the contacts file.
  resultKey     String?          @map("result_key")
  error         String?
  startedAt     DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("contact_jobs")
}

/// One thread per (business number, contact). A new inbound message reopens a closed one.
model Conversation {
  id                 String             @id @default(uuid(7)) @db.Uuid
  orgId              String             @map("org_id") @db.Uuid
  phoneId            String             @map("phone_id") @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  status             ConversationStatus @default(open)
  assigneeId         String?            @map("assignee_id") @db.Uuid
  /// Free-form replies are allowed until this time: last inbound message + 24 hours.
  windowExpiresAt    DateTime?          @map("window_expires_at") @db.Timestamptz(3)
  lastMessageAt      DateTime?          @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String?            @map("last_message_preview")
  unreadCount        Int                @default(0) @map("unread_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone              PhoneNumber         @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee           User?               @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  messages           Message[]
  labels             ConversationLabel[]
  flowRuns           FlowRun[]
  /// The customer's first message that no person has answered yet. Null once someone replies.
  awaitingReplySince DateTime?           @map("awaiting_reply_since") @db.Timestamptz(3)
  /// When the SLA is next checked: the deadline, then the escalation time after a breach.
  slaDueAt           DateTime?           @map("sla_due_at") @db.Timestamptz(3)
  /// 0 within the SLA, 1 breached, 2 escalated.
  slaStage           Int                 @default(0) @map("sla_stage")

  @@unique([orgId, phoneId, contactId])
  @@index([orgId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, assigneeId])
  @@index([slaDueAt])
  @@map("conversations")
}

/// PARTITIONED BY MONTH on created_at (see the *_inbox migration). Partitions live in the
/// message_partitions schema, which the app role cannot reach. Always page by cursor.
model Message {
  id             String           @default(uuid(7)) @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  orgId          String           @map("org_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  /// text, image, template, note, ... A string: Meta adds message types over time.
  type           String
  status         MessageStatus
  body           String?
  /// Template name and parameters, or the raw content of types with no dedicated columns.
  content        Json?
  senderUserId   String?          @map("sender_user_id") @db.Uuid
  waMessageId    String?          @map("wa_message_id")
  errorCode      String?          @map("error_code")
  errorMessage   String?          @map("error_message")
  mediaMetaId    String?          @map("media_meta_id")
  mediaKey       String?          @map("media_key")
  mediaMime      String?          @map("media_mime")
  mediaSize      Int?             @map("media_size")
  mediaFilename  String?          @map("media_filename")
  mediaStatus    MediaStatus?     @map("media_status")
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz(3)
  deliveredAt    DateTime?        @map("delivered_at") @db.Timestamptz(3)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)
  failedAt       DateTime?        @map("failed_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@id([id, createdAt])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

/// Unique lookups a partitioned table cannot enforce: wamid (inbound dedupe, status updates) and
/// the client's idempotency key. Points at the message, including its partition key.
model MessageRef {
  orgId            String   @map("org_id") @db.Uuid
  /// 'wamid', 'client', or 'automation' (the rules ran for this inbound message).
  kind             String
  ref              String
  messageId        String   @map("message_id") @db.Uuid
  messageCreatedAt DateTime @map("message_created_at") @db.Timestamptz(3)

  @@id([orgId, kind, ref])
  @@map("message_refs")
}

model Label {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([orgId, name])
  @@map("labels")
}

model ConversationLabel {
  orgId          String @map("org_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  labelId        String @map("label_id") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([orgId])
  @@map("conversation_labels")
}

model CannedReply {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  shortcut    String
  body        String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orgId, shortcut])
  @@map("canned_replies")
}

/// A message template in one language on one WABA. Mirrors Meta, which is the authority: once
/// submitted, edits go to Meta first, so this never differs from what was approved.
model MessageTemplate {
  id              String    @id @default(uuid(7)) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  wabaAccountId   String    @map("waba_account_id") @db.Uuid
  /// Null while a draft that has never been submitted.
  metaTemplateId  String?   @map("meta_template_id")
  name            String
  language        String
  /// Strings: Meta adds categories and statuses over time.
  category        String
  /// draft, pending, approved, rejected, paused, disabled, ...
  status          String    @default("draft")
  parameterFormat String    @default("positional") @map("parameter_format")
  /// TemplateDefinition from @wacrm/shared. Null when Meta's template could not be read.
  definition      Json?
  samples         Json      @default("{}")
  /// Variable key -> where its value comes from when sending to a contact.
  variableMapping Json      @default("{}") @map("variable_mapping")
  /// False for templates made elsewhere that use parts this app cannot send.
  supported       Boolean   @default(true)
  rejectedReason  String?   @map("rejected_reason")
  /// Meta's recommendation or pause details, as text for people.
  statusDetail    String?   @map("status_detail")
  qualityScore    String?   @map("quality_score")
  headerMediaKey  String?   @map("header_media_key")
  headerMediaMime String?   @map("header_media_mime")
  headerMediaName String?   @map("header_media_name")
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  /// When the status last changed. An older webhook, such as a replay, cannot move it back.
  statusAt        DateTime  @default(now()) @map("status_at") @db.Timestamptz(3)
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wabaAccount  WabaAccount  @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  campaigns    Campaign[]
  dripSteps    DripStep[]

  @@unique([orgId, wabaAccountId, name, language])
  @@index([orgId, metaTemplateId])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("message_templates")
}

/// One per org. balance_micros is the running total of wallet_ledger, kept so a check under the
/// row lock does not add up history. CHECK constraints refuse a negative balance. All changes go
/// through the functions in src/wallet.ts.
model Wallet {
  id                        String    @id @default(uuid(7)) @db.Uuid
  orgId                     String    @unique @map("org_id") @db.Uuid
  currency                  String
  balanceMicros             BigInt    @default(0) @map("balance_micros")
  /// Held for running campaigns. What new sends can use is balance minus this.
  reservedMicros            BigInt    @default(0) @map("reserved_micros")
  /// Null turns the alert off.
  lowBalanceThresholdMicros BigInt?   @map("low_balance_threshold_micros")
  /// Set when an alert went out, and cleared by a top-up, so each crossing alerts once.
  lowBalanceAlertedAt       DateTime? @map("low_balance_alerted_at") @db.Timestamptz(3)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries      WalletLedger[]
  reservations WalletReservation[]

  @@map("wallets")
}

/// Append-only: the app role has no UPDATE or DELETE. The rate is copied onto each entry, so a
/// later rate change cannot alter what a past message cost.
model WalletLedger {
  id                 String          @id @default(uuid(7)) @db.Uuid
  orgId              String          @map("org_id") @db.Uuid
  walletId           String          @map("wallet_id") @db.Uuid
  type               WalletEntryType
  /// Positive adds to the balance. Negative takes from it.
  amountMicros       BigInt          @map("amount_micros")
  balanceAfterMicros BigInt          @map("balance_after_micros")
  /// message, campaign, payment, manual, ...
  referenceType      String?         @map("reference_type")
  referenceId        String?         @map("reference_id")
  /// The same key never applies twice in one org.
  idempotencyKey     String          @map("idempotency_key")
  description        String?
  actorUserId        String?         @map("actor_user_id") @db.Uuid
  rateCardId         String?         @map("rate_card_id") @db.Uuid
  rateMicros         BigInt?         @map("rate_micros")
  country            String?
  category           String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  rateCard     RateCard?    @relation(fields: [rateCardId], references: [id], onDelete: SetNull)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, category, createdAt])
  @@index([orgId, referenceType, referenceId])
  @@map("wallet_ledger")
}

/// Funds held for a campaign. They stay in the balance until a send uses them.
model WalletReservation {
  id             String                  @id @default(uuid(7)) @db.Uuid
  orgId          String                  @map("org_id") @db.Uuid
  walletId       String                  @map("wallet_id") @db.Uuid
  amountMicros   BigInt                  @map("amount_micros")
  consumedMicros BigInt                  @default(0) @map("consumed_micros")
  status         WalletReservationStatus @default(active)
  referenceType  String                  @map("reference_type")
  referenceId    String                  @map("reference_id")
  idempotencyKey String                  @map("idempotency_key")
  /// A hold left by a crashed campaign goes back after this.
  expiresAt      DateTime                @map("expires_at") @db.Timestamptz(3)
  releasedAt     DateTime?               @map("released_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([walletId, status, expiresAt])
  @@map("wallet_reservations")
}

/// Platform prices, the same for every org, so no org_id. The app role can only read them.
/// Versioned: a new price is a new row with a later valid_from, and rows are never changed.
model RateCard {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Two-letter country code, or * for any country with no rate of its own.
  country    String
  /// marketing, utility, authentication, service
  category   String
  currency   String
  rateMicros BigInt   @map("rate_micros")
  validFrom  DateTime @map("valid_from") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries WalletLedger[]

  @@unique([country, category, currency, validFrom])
  @@index([currency, category, country, validFrom(sort: Desc)])
  @@map("rate_cards")
}

/// A broadcast of one template. Totals come from counting recipients and the ledger when asked,
/// so they cannot drift from what happened.
model Campaign {
  id              String         @id @default(uuid(7)) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  name            String
  status          CampaignStatus @default(draft)
  phoneId         String         @map("phone_id") @db.Uuid
  templateId      String         @map("template_id") @db.Uuid
  /// { type: 'segment', filter, segmentId? } or { type: 'csv', key, filename, phoneColumn, ... }
  audience        Json
  /// Variable key -> source. Starts from the template's mapping.
  variableMapping Json           @default("{}") @map("variable_mapping")
  /// In UTC. The timezone it was chosen in is kept for display.
  scheduledAt     DateTime?      @map("scheduled_at") @db.Timestamptz(3)
  timezone        String?
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)
  /// Why it is paused or failed, as a stable code, with words for people beside it.
  pauseCode       String?        @map("pause_code")
  pauseReason     String?        @map("pause_reason")
  reservationId   String?        @map("reservation_id") @db.Uuid
  estimateMicros  BigInt         @default(0) @map("estimate_micros")
  /// Rows in a CSV audience that could not be used.
  invalidRows     Int            @default(0) @map("invalid_rows")
  /// Waiting for the number's daily limit, not stuck.
  waitingUntil    DateTime?      @map("waiting_until") @db.Timestamptz(3)
  createdById     String?        @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone        PhoneNumber         @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  template     MessageTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id               String                  @id @default(uuid(7)) @db.Uuid
  orgId            String                  @map("org_id") @db.Uuid
  campaignId       String                  @map("campaign_id") @db.Uuid
  contactId        String                  @map("contact_id") @db.Uuid
  /// Kept here so the number's daily limit can be counted without a join.
  phoneId          String                  @map("phone_id") @db.Uuid
  status           CampaignRecipientStatus @default(pending)
  /// no_consent, opted_out, missing_variable, merged
  skipReason       String?                 @map("skip_reason")
  /// Resolved values, by variable key.
  variables        Json                    @default("{}")
  estimateMicros   BigInt                  @default(0) @map("estimate_micros")
  attempts         Int                     @default(0)
  nextAttemptAt    DateTime?               @map("next_attempt_at") @db.Timestamptz(3)
  messageId        String?                 @map("message_id") @db.Uuid
  messageCreatedAt DateTime?               @map("message_created_at") @db.Timestamptz(3)
  errorCode        String?                 @map("error_code")
  errorMessage     String?                 @map("error_message")
  sentAt           DateTime?               @map("sent_at") @db.Timestamptz(3)
  repliedAt        DateTime?               @map("replied_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phone    PhoneNumber @relation(fields: [phoneId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status, id])
  @@index([messageId])
  @@index([phoneId, sentAt])
  @@index([contactId, sentAt])
  @@index([orgId])
  @@map("campaign_recipients")
}

/// Meta's daily limit for each tier. Config, because Meta changes these.
model MessagingTierLimit {
  tier            String @id
  /// Unique customers in a rolling 24 hours. Null means no limit.
  dailyRecipients Int?   @map("daily_recipients")

  @@map("messaging_tier_limits")
}

model DripSequence {
  id          String             @id @default(uuid(7)) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  name        String
  status      DripSequenceStatus @default(draft)
  phoneId     String             @map("phone_id") @db.Uuid
  /// Stop when the contact replies. Opting out always stops it.
  exitOnReply Boolean            @default(true) @map("exit_on_reply")
  /// Stop when the contact has this tag.
  exitTagId   String?            @map("exit_tag_id") @db.Uuid
  createdById String?            @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone        PhoneNumber      @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  steps        DripStep[]
  enrollments  DripEnrollment[]

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("drip_sequences")
}

model DripStep {
  id              String @id @default(uuid(7)) @db.Uuid
  orgId           String @map("org_id") @db.Uuid
  sequenceId      String @map("sequence_id") @db.Uuid
  position        Int
  /// After the previous step, or after enrolling for the first step.
  delayMinutes    Int    @map("delay_minutes")
  templateId      String @map("template_id") @db.Uuid
  variableMapping Json   @default("{}") @map("variable_mapping")

  sequence DripSequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([sequenceId, position])
  @@index([orgId])
  @@map("drip_steps")
}

model DripEnrollment {
  id         String               @id @default(uuid(7)) @db.Uuid
  orgId      String               @map("org_id") @db.Uuid
  sequenceId String               @map("sequence_id") @db.Uuid
  contactId  String               @map("contact_id") @db.Uuid
  status     DripEnrollmentStatus @default(active)
  /// Position of the next step to send.
  nextStep   Int                  @default(0) @map("next_step")
  nextRunAt  DateTime?            @map("next_run_at") @db.Timestamptz(3)
  exitReason String?              @map("exit_reason")
  /// A reply after this time stops the sequence.
  enrolledAt DateTime             @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  sequence DripSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([status, nextRunAt])
  @@index([contactId, status])
  @@index([orgId])
  @@map("drip_enrollments")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled

  @@map("subscription_status")
}

enum WalletTopupStatus {
  created
  paid
  failed

  @@map("wallet_topup_status")
}

enum BillingEventStatus {
  received
  processed
  ignored
  failed

  @@map("billing_event_status")
}

/// What a workspace can do. Same for everyone, so no org_id, and the app role can only read it.
model Plan {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  /// Null means no limit.
  seats       Int?
  numbers     Int?
  contacts    Int?
  /// Feature keys from PLAN_FEATURES in packages/shared.
  features    Json     @default("[]")
  isPublic    Boolean  @default(true) @map("is_public")
  /// New workspaces start a trial of this plan.
  isTrial     Boolean  @default(false) @map("is_trial")
  trialDays   Int      @default(14) @map("trial_days")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  prices        PlanPrice[]
  subscriptions Subscription[]

  @@map("plans")
}

/// What the provider charges, tax included. The provider ids come from its dashboard.
model PlanPrice {
  id             String  @id @default(uuid(7)) @db.Uuid
  planId         String  @map("plan_id") @db.Uuid
  currency       String
  /// month or year
  interval       String
  amountMicros   BigInt  @map("amount_micros")
  stripePriceId  String? @map("stripe_price_id")
  razorpayPlanId String? @map("razorpay_plan_id")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency, interval])
  @@map("plan_prices")
}

/// Tax by billing country. Config, read-only to the app. A country with no row pays no tax.
model TaxRate {
  country String @id
  rateBps Int    @map("rate_bps")
  label   String

  @@map("tax_rates")
}

/// One per workspace. Provider webhooks are what move it, never a browser redirect.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  orgId                  String             @unique @map("org_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus
  provider               String?
  providerSubscriptionId String?            @map("provider_subscription_id")
  providerCustomerId     String?            @map("provider_customer_id")
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])

  @@index([provider, providerSubscriptionId])
  @@map("subscriptions")
}

/// A wallet top-up someone started. Money only moves when a verified webhook says it was paid.
model WalletTopup {
  id           String            @id @default(uuid(7)) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  status       WalletTopupStatus @default(created)
  provider     String
  providerRef  String?           @map("provider_ref")
  currency     String
  /// What reaches the wallet.
  creditMicros BigInt            @map("credit_micros")
  taxMicros    BigInt            @map("tax_micros")
  taxRateBps   Int               @map("tax_rate_bps")
  taxLabel     String?           @map("tax_label")
  /// What the customer pays: credit plus tax.
  totalMicros  BigInt            @map("total_micros")
  createdById  String?           @map("created_by_id") @db.Uuid
  failure      String?
  paidAt       DateTime?         @map("paid_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([provider, providerRef])
  @@map("wallet_topups")
}

/// A paid invoice. Tax and both parties' details are copied on, so it never changes afterwards.
model Invoice {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  number         String    @unique
  /// subscription or topup
  kind           String
  provider       String
  /// The provider's id for this payment. Unique, so a redelivery cannot bill twice.
  providerRef    String    @map("provider_ref")
  description    String
  currency       String
  subtotalMicros BigInt    @map("subtotal_micros")
  taxMicros      BigInt    @map("tax_micros")
  taxRateBps     Int       @map("tax_rate_bps")
  taxLabel       String?   @map("tax_label")
  totalMicros    BigInt    @map("total_micros")
  billTo         Json      @map("bill_to")
  periodStart    DateTime? @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime? @map("period_end") @db.Timestamptz(3)
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orgId, issuedAt(sort: Desc), id(sort: Desc)])
  @@map("invoices")
}

/// The raw provider event, stored before anything else happens. One row per provider event id.
model BillingEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String             @map("event_id")
  type        String
  payload     Json
  status      BillingEventStatus @default(received)
  orgId       String?            @map("org_id") @db.Uuid
  error       String?
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(3)

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([orgId, receivedAt(sort: Desc)])
  @@map("billing_events")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed

  @@map("webhook_delivery_status")
}

/// Where a workspace wants its events sent. The secret signs them, and is shown only when set.
model WebhookEndpoint {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  url         String
  description String?
  /// Event types from WEBHOOK_EVENTS in packages/shared.
  events      String[]
  secretEnc   String   @map("secret_enc")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  /// Set when Zapier, Make or similar subscribed through the public API with this key. Such an
  /// endpoint receives events only while the key is live, and goes when the key is revoked.
  apiKeyId    String?  @map("api_key_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  apiKey     ApiKey?           @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([orgId])
  @@index([apiKeyId])
  @@map("webhook_endpoints")
}

/// One event for one endpoint, written in the transaction of the change it reports. Also the log.
model WebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  orgId          String                @map("org_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  /// The same across retries and replays, so a receiver can dedupe on it.
  eventId        String                @map("event_id") @db.Uuid
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?             @map("next_attempt_at") @db.Timestamptz(3)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  error          String?
  durationMs     Int?                  @map("duration_ms")
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(3)
  replayOfId     String?               @map("replay_of_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, id(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

/// One row. Only next_invoice_number() touches it, and the app role has no access.
model InvoiceCounter {
  id    Boolean @id @default(true)
  value BigInt  @default(0)

  @@map("invoice_counter")
}

/// One per workspace. Missing means everything is off.
model AutomationSettings {
  orgId                   String   @id @map("org_id") @db.Uuid
  welcomeEnabled          Boolean  @default(false) @map("welcome_enabled")
  welcomeMessage          String?  @map("welcome_message")
  awayEnabled             Boolean  @default(false) @map("away_enabled")
  awayMessage             String?  @map("away_message")
  /// BusinessHours from packages/shared. Null means always open.
  businessHours           Json?    @map("business_hours")
  awayCooldownMinutes     Int      @default(720) @map("away_cooldown_minutes")
  /// none, round_robin or load_based. Used when no assignment rule matches.
  defaultAssignment       String   @default("none") @map("default_assignment")
  /// Where the default round-robin left off.
  lastAssignedUserId      String?  @map("last_assigned_user_id") @db.Uuid
  slaEnabled              Boolean  @default(false) @map("sla_enabled")
  slaFirstResponseMinutes Int      @default(60) @map("sla_first_response_minutes")
  slaEscalateAfterMinutes Int?     @map("sla_escalate_after_minutes")
  slaReassignOnEscalate   Boolean  @default(false) @map("sla_reassign_on_escalate")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("automation_settings")
}

model AutoReplyRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  /// exact, contains or regex
  matchType String   @map("match_type")
  keywords  String[] @default([])
  pattern   String?
  reply     String
  phoneId   String?  @map("phone_id") @db.Uuid
  priority  Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, priority])
  @@map("auto_reply_rules")
}

model AssignmentRule {
  id                 String   @id @default(uuid(7)) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  name               String
  active             Boolean  @default(true)
  priority           Int      @default(100)
  /// round_robin or load_based
  strategy           String
  tagIds             String[] @default([]) @map("tag_ids") @db.Uuid
  phoneIds           String[] @default([]) @map("phone_ids") @db.Uuid
  keywords           String[] @default([])
  agentIds           String[] @default([]) @map("agent_ids") @db.Uuid
  skill              String?
  /// Where this rule's round-robin left off.
  lastAssignedUserId String?  @map("last_assigned_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, priority])
  @@map("assignment_rules")
}

/// For one person in one workspace. Only they can read it.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// NOTIFICATION_KINDS in packages/shared
  kind           String
  title          String
  body           String?
  conversationId String?   @map("conversation_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, id(sort: Desc)])
  @@map("notifications")
}

/// A chatbot flow. `draft` is edited freely; runs use a published, immutable FlowVersion.
model Flow {
  id                 String    @id @default(uuid(7)) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  name               String
  /// Only active flows with a published version start runs.
  active             Boolean   @default(false)
  /// The published trigger, copied out of the definition so triggers can be found by type.
  triggerType        String    @default("manual") @map("trigger_type")
  trigger            Json      @default("{\"type\":\"manual\"}")
  draft              Json
  publishedVersionId String?   @unique @map("published_version_id") @db.Uuid
  createdById        String?   @map("created_by_id") @db.Uuid
  /// Removed flows keep their runs and history.
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  org              Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  publishedVersion FlowVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  versions         FlowVersion[] @relation("FlowVersions")
  runs             FlowRun[]

  @@index([orgId, active, triggerType])
  @@map("flows")
}

/// A published definition. Never changed: runs started on it keep running on it.
model FlowVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  flowId        String   @map("flow_id") @db.Uuid
  version       Int
  definition    Json
  publishedById String?  @map("published_by_id") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(3)

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  flow        Flow         @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Cascade)
  publishedOf Flow?        @relation("PublishedVersion")
  runs        FlowRun[]

  @@unique([flowId, version])
  @@index([orgId])
  @@map("flow_versions")
}

/// One contact going through one flow version.
model FlowRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  flowId         String    @map("flow_id") @db.Uuid
  versionId      String    @map("version_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  /// running, waiting, completed, failed or cancelled
  status         String    @default("running")
  currentNodeId  String?   @map("current_node_id")
  variables      Json      @default("{}")
  /// What started the run, readable as {{trigger.*}}.
  trigger        Json      @default("{}")
  /// The node waiting, and its retries: { nodeId, kind, attempts }.
  awaiting       Json?
  /// A reply or timeout handed to the waiting node: { kind: 'reply' | 'timeout', ... }.
  input          Json?
  /// When a delay or a wait for a reply ends.
  wakeAt         DateTime? @map("wake_at") @db.Timestamptz(3)
  steps          Int       @default(0)
  stepsSinceWait Int       @default(0) @map("steps_since_wait")
  endReason      String?   @map("end_reason")
  error          String?
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  flow         Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version      FlowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  history      FlowRunStep[]

  @@index([status, wakeAt])
  @@index([orgId, flowId, id(sort: Desc)])
  @@index([contactId, flowId])
  @@map("flow_runs")
}

/// What each node did, for debugging. Append-only.
model FlowRunStep {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  nodeId    String   @map("node_id")
  nodeType  String   @map("node_type")
  /// The exit taken, or waiting, failed, ended.
  outcome   String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run FlowRun      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, id])
  @@index([orgId])
  @@map("flow_run_steps")
}

/// One account connected through a connector (packages/connectors).
model IntegrationConnection {
  id               String    @id @default(uuid(7)) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  /// The connector's key in the registry.
  connectorKey     String    @map("connector_key")
  name             String
  /// connected, error, needs_reconnect or disconnected
  status           String    @default("connected")
  /// SecretBox ciphertext of a JSON object (API keys, OAuth tokens, webhook secret). AAD bound to the row.
  credentialsEnc   String?   @map("credentials_enc")
  /// Plain settings, such as a store address.
  settings         Json      @default("{}")
  /// The unguessable part of the webhook address. Requests are still checked by signature.
  webhookToken     String?   @unique @map("webhook_token")
  tokenExpiresAt   DateTime? @map("token_expires_at") @db.Timestamptz(3)
  lastHealthAt     DateTime? @map("last_health_at") @db.Timestamptz(3)
  lastError        String?   @map("last_error")
  /// Copied from the connector when connecting, so the scheduler can find due syncs in SQL.
  syncEveryMinutes Int?      @map("sync_every_minutes")
  syncCursor       Json?     @map("sync_cursor")
  lastSyncAt       DateTime? @map("last_sync_at") @db.Timestamptz(3)
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  org    Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events IntegrationEvent[]

  @@index([orgId, connectorKey])
  @@map("integration_connections")
}

/// Everything that came in from or went out to a connection, with its retry state.
model IntegrationEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  connectionId  String    @map("connection_id") @db.Uuid
  /// inbound or outbound
  direction     String
  /// Trigger key (inbound, once mapped) or action key (outbound).
  type          String?
  /// The provider's delivery or event id, or the body's hash. Redeliveries collapse onto one row.
  dedupeKey     String    @map("dedupe_key")
  /// received, processed, ignored, succeeded or failed
  status        String
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  payload       Json
  result        Json?
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  org        Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, direction, dedupeKey])
  @@index([orgId, connectionId, id(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("integration_events")
}

/// Each outside event (an order, a payment) acts once, however it arrives: by webhook, redelivery or sync.
model IntegrationEventClaim {
  connectionId String   @map("connection_id") @db.Uuid
  /// The connector's own id for the event, such as `order.created:1001`.
  externalId   String   @map("external_id")
  orgId        String   @map("org_id") @db.Uuid
  /// The inbound event that acted on it.
  eventId      String   @map("event_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([connectionId, externalId])
  @@index([orgId])
  @@map("integration_event_claims")
}

// ------------------------------------------------------------------ AI (Phase 3.7)

/// One per workspace; missing means AI is off. Nothing is sent without auto_reply.
model AiSettings {
  orgId         String   @id @map("org_id") @db.Uuid
  enabled       Boolean  @default(false)
  inboxAssist   Boolean  @default(true) @map("inbox_assist")
  autoReply     Boolean  @default(false) @map("auto_reply")
  minConfidence Float    @default(0.7) @map("min_confidence")
  instructions  String   @default("")
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

/// A knowledge base document. Its text is kept in object storage; the passages are below.
/// Deleted documents are soft-deleted and their passages removed.
model KnowledgeDocument {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  title          String
  /// text | upload
  source         String
  mimeType       String?   @map("mime_type")
  sizeBytes      Int       @default(0) @map("size_bytes")
  fileKey        String    @map("file_key")
  /// pending | indexing | ready | failed
  status         String    @default("pending")
  error          String?
  chunkCount     Int       @default(0) @map("chunk_count")
  embeddingModel String?   @map("embedding_model")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([orgId, createdAt])
  @@map("knowledge_documents")
}

/// One passage and its embedding. Searched with exact cosine distance within one workspace.
model KnowledgeChunk {
  id             String                      @id @default(uuid(7)) @db.Uuid
  orgId          String                      @map("org_id") @db.Uuid
  documentId     String                      @map("document_id") @db.Uuid
  ordinal        Int
  content        String
  tokens         Int
  embedding      Unsupported("vector(1024)")
  embeddingModel String                      @map("embedding_model")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([orgId, embeddingModel])
  @@index([documentId])
  @@map("knowledge_chunks")
}

/// Every AI call: what it was given, what it said, what it cost, whether it was sent.
/// Append-only.
model AiLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  /// suggestion | summary | rewrite | flow_reply | indexing
  kind           String
  /// answered | handoff | refused | failed
  status         String
  model          String
  conversationId String?  @map("conversation_id") @db.Uuid
  flowRunId      String?  @map("flow_run_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  input          String
  output         String
  confidence     Float?
  sources        Json     @default("[]")
  sent           Boolean  @default(false)
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  costMicros     BigInt   @default(0) @map("cost_micros")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, kind, createdAt])
  @@map("ai_logs")
}
