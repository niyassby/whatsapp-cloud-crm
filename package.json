{
  "name": "whatsapp-cloud-crm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @wacrm/db run migrate",
    "db:migrate:deploy": "pnpm --filter @wacrm/db run migrate:deploy",
    "db:roles": "pnpm --filter @wacrm/db run roles",
    "db:seed": "pnpm --filter @wacrm/db run seed",
    "db:studio": "pnpm --filter @wacrm/db run studio",
    "prepare": "husky",
    "db:setup": "pnpm db:migrate:deploy && pnpm db:roles && pnpm db:seed",
    "secrets:reencrypt": "pnpm --filter @wacrm/worker exec tsx src/scripts/reencrypt.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "20",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.10",
    "typescript": "5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
