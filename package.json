{
  "name": "whatsapp-cloud-crm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "services:status": "node scripts/services.mjs status",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @wacrm/db run migrate",
    "db:migrate:deploy": "pnpm --filter @wacrm/db run migrate:deploy",
    "db:roles": "pnpm --filter @wacrm/db run roles",
    "db:seed": "pnpm --filter @wacrm/db run seed",
    "db:demo": "pnpm --filter @wacrm/db run demo",
    "rates:import": "pnpm --filter @wacrm/db run rates:import",
    "wallet:credit": "pnpm --filter @wacrm/db run wallet:credit",
    "admin:grant": "pnpm --filter @wacrm/db run admin:grant",
    "plans:import": "pnpm --filter @wacrm/db run plans:import",
    "db:studio": "pnpm --filter @wacrm/db run studio",
    "prepare": "husky",
    "db:setup": "pnpm db:migrate:deploy && pnpm db:roles && pnpm db:seed",
    "secrets:reencrypt": "pnpm --filter @wacrm/worker exec tsx src/scripts/reencrypt.ts",
    "events:requeue": "pnpm --filter @wacrm/worker exec tsx src/scripts/requeue-events.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "20",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.13",
    "typescript": "5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
